    part.Transparency = 1
    part.CanCollide = false
    part.CanQuery = false
    part.CanTouch = false
    part.Anchored = false
    part.Massless = true
    part.CFrame = detector.CFrame
    part.Parent = Workspace
    local bp = Instance.new("BodyPosition")
    bp.MaxForce = Vector3.new(100000, 100000, 100000)
    bp.D = 200
    bp.P = 1000
    bp.Position = detector.Position
    bp.Parent = part
    local bg = Instance.new("BodyGyro")
    bg.MaxTorque = Vector3.new(100000, 100000, 100000)
    bg.D = 200
    bg.P = 1000
    bg.CFrame = detector.CFrame
    bg.Parent = part
    local box = Instance.new("BoxHandleAdornment")
    box.Adornee = part
    box.AlwaysOnTop = true
    box.ZIndex = 5
    box.Color3 = ApplyPCLDColor()
    box.Transparency = pcldTransparency
    box.Size = detector.Size
    box.Parent = game.CoreGui
    local highlight = Instance.new("Highlight")
    highlight.Adornee = part
    highlight.FillColor = ApplyPCLDColor()
    highlight.FillTransparency = pcldTransparency
    highlight.OutlineColor = Color3.fromRGB(64, 64, 64)
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = part
    local billboard = Instance.new("BillboardGui")
    billboard.Size = UDim2.new(0, 160, 0, 46)
    billboard.StudsOffset = Vector3.new(0, -2.5, 0)
    billboard.AlwaysOnTop = true
    billboard.LightInfluence = 0
    billboard.MaxDistance = 1000
    billboard.Parent = part
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = "PCLD | " .. ownerDisplay .. "\n(" .. ownerName .. ")"
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    label.TextStrokeTransparency = 0
    label.Font = Enum.Font.SourceSansBold
    label.TextSize = 12
    label.TextScaled = false
    label.TextWrapped = true
    label.Parent = billboard
